# =============================================================================
# HealthPassport Pro — environment variables
# =============================================================================
# HOW TO USE
#   1. Make a copy of this file in the same folder and name the copy ".env"
#      (Windows PowerShell:  Copy-Item .env.example .env)
#   2. Fill in the values below.
#   3. NEVER commit your real ".env" file — it holds secrets. Only this
#      ".env.example" (with fake values) belongs in git.
#
# NOTE: If you run the app with Docker (`docker compose up --build`) you do
# NOT need a .env file at all — docker-compose.yml already provides everything.
# You only need this file for the manual (no-Docker) setup.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection the app uses at runtime.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthpassport?schema=public"

# Direct (non-pooled) connection used by Prisma when running migrations.
# For a normal local PostgreSQL this is the SAME value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/healthpassport?schema=public"

# --- Authentication (required) ----------------------------------------------
# A long, random secret used to sign login sessions.
# Generate one:
#   macOS/Linux:            openssl rand -base64 32
#   Windows PowerShell:     [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# Any long random string works for local use.
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# The URL the app is served from. For local development this is correct as-is.
AUTH_URL="http://localhost:3000"

# Lets Auth.js trust the local host header. Keep this "true" for local runs.
AUTH_TRUST_HOST="true"

# --- Runtime -----------------------------------------------------------------
# "development" while you work locally; "production" for a real deployment.
NODE_ENV="development"

# --- Optional: demo data -----------------------------------------------------
# When "true", a synthetic demo patient is seeded (email demo@healthpassport.local
# / password Demo!12345). Only used by the Docker entrypoint. Never real data.
SEED_DEMO="true"
