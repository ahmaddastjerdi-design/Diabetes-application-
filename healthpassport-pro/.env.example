# Copy to .env and fill in. NEVER commit a real .env. See docs/DEPLOYMENT.md.

# --- Database (Phase 2) ---
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/healthpassport?schema=public"
# Direct connection used by Prisma migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/healthpassport?schema=public"

# --- Auth (Phase 2) ---
# Canonical app URL.
NEXTAUTH_URL="http://localhost:3000"
# Long random secret: generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# --- Object storage (Phase 7) ---
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
