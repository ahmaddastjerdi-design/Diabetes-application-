# Dependencies
/node_modules

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build

# Prisma (generated client is committed via node_modules; keep local artifacts out)
# (migrations ARE committed; see prisma/migrations)

# Local document storage (never commit uploaded files)
/.uploads

# Env / secrets — never commit real values
.env
.env*.local
.env.production

# Test / coverage
/coverage
.vitest/

# TypeScript
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
