{
  "name": "@diabetes-quest/device-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Diabetes Quest device ingest: Health Connect / BLE / vendor cloud -> FHIR Observations (Vol 5).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:full": "tsc -p tsconfig.full.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:full": "tsc --noEmit -p tsconfig.full.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist-full/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test-integration/*.test.mjs"
  },
  "dependencies": {
    "@diabetes-quest/shared": "*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "~6.0.3",
    "@types/node": "^22.0.0"
  },
  "license": "SEE LICENSE IN ../../../LICENSE"
}
